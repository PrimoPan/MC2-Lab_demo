{
  "name": "mc2-lab-react",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=10.8.2"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "^8.18.0",
    "ajv-keywords": "^5.1.0",
    "glob": "^13.0.6",
    "htmlparser2": "^9.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run build && cp build/index.html build/404.html && touch build/.nojekyll",
    "preview": "vite preview",
    "pub:update": "tsx tools/update-publications.ts",
    "update:all": "npm run pub:update && npm run build",
    "pub:sync": "tsx tools/sync-recent-publications.ts",
    "pub:sync:check": "tsx tools/sync-recent-publications.ts --check"
  }
}
